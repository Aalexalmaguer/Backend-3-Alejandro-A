# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# Nunca escribas valores sensibles directamente en el código: todos se leen
# desde acá (centralizado en src/config/index.js).

# Puerto donde escucha la API (opcional, por defecto 8080)
PORT=8080

# Cadena de conexión a MongoDB (OBLIGATORIA: sin esto la app no arranca)
MONGODB_URI=mongodb://localhost:27017/shipnow

# Entorno de ejecución: development | test | production (opcional, por defecto development)
NODE_ENV=development

# Nivel de logs (opcional): fatal | error | warning | info | http | debug
# Por defecto: debug en development, info en production.
LOG_LEVEL=debug

# Secreto para JWT (opcional; para cuando se agregue autenticación)
# JWT_SECRET=cambia_esto_por_un_secreto

# URL de servicios externos (opcional; ejemplo para integraciones futuras)
# EXTERNAL_SERVICE_URL=https://api.servicio-externo.com

# Exponer endpoints internos (/mocks, /logs) en producción (opcional).
# Por defecto quedan deshabilitados en production. Poné "true" para habilitarlos.
# ENABLE_INTERNAL_ENDPOINTS=false

# --- Testing (opcional) ---
# Los tests usan por defecto una base MongoDB EN MEMORIA (no requiere config).
# Si preferís usar una base de datos de testing separada, definí esta variable
# y los tests se conectarán a ella en lugar de la base en memoria:
# MONGODB_URI_TEST=mongodb://localhost:27017/shipnow-test
