# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha la API (opcional, por defecto 8080)
PORT=8080

# Cadena de conexión a MongoDB (OBLIGATORIA: sin esto la app no arranca)
MONGODB_URI=mongodb://localhost:27017/shipnow

# Entorno de ejecución: development | test | production (opcional, por defecto development)
NODE_ENV=development
